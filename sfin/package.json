{
  "name": "insurance-erp-ui",
  "version": "3.0.0",
  "description": "Modern UI Framework for Insurance ERP with Tailwind CSS & Alpine.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch",
    "build": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --minify",
    "watch": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch"
  },
  "keywords": [
    "insurance",
    "erp",
    "tailwindcss",
    "alpinejs"
  ],
  "author": "Insurance ERP Team",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35"
  },
  "dependencies": {
    "alpinejs": "^3.13.5",
    "aos": "^2.3.4",
    "chart.js": "^4.4.1",
    "apexcharts": "^3.45.2",
    "gsap": "^3.12.5",
    "sweetalert2": "^11.10.5",
    "toastify-js": "^1.12.0"
  }
}
