SESSION_MATCH_IP = FALSE
SESSION_TIME_TO_UPDATE = 300
SESSION_REGENERATE_DESTROY = FALSE

#--------------------------------------------------------------------
# EMAIL SETTINGS
#--------------------------------------------------------------------
MAIL_PROTOCOL = smtp
MAIL_SMTP_HOST = smtp.gmail.com
MAIL_SMTP_PORT = 587
MAIL_SMTP_USER = your-email@gmail.com
MAIL_SMTP_PASS = your-password
MAIL_SMTP_CRYPTO = tls
MAIL_FROM_EMAIL = noreply@yourdomain.com
MAIL_FROM_NAME = Insurance ERP

#--------------------------------------------------------------------
# FILE UPLOAD SETTINGS
#--------------------------------------------------------------------
UPLOAD_MAX_SIZE = 2048
# Maximum file size in KB (2048 = 2MB)

UPLOAD_ALLOWED_TYPES = jpg|jpeg|png|gif|pdf|doc|docx|xls|xlsx
# Allowed file types for upload

UPLOAD_PATH = ./uploads/
# Upload directory path

#--------------------------------------------------------------------
# COMPANY SETTINGS
#--------------------------------------------------------------------
COMPANY_NAME = "Insurance Company Ltd"
COMPANY_LICENSE =
COMPANY_TAX_NUMBER =
COMPANY_CURRENCY = AED
COMPANY_VAT_RATE = 5.00

#--------------------------------------------------------------------
# BACKUP SETTINGS
#--------------------------------------------------------------------
BACKUP_ENABLED = true
BACKUP_FREQUENCY = daily
# Options: daily, weekly, monthly

BACKUP_PATH = ./backups/
BACKUP_KEEP_COUNT = 30
# Number of backups to keep

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
CSRF_PROTECTION = TRUE
CSRF_TOKEN_NAME = erp_csrf_token
CSRF_COOKIE_NAME = erp_csrf_cookie
CSRF_EXPIRE = 7200
CSRF_REGENERATE = TRUE

#--------------------------------------------------------------------
# PAGINATION
#--------------------------------------------------------------------
PER_PAGE = 20
# Default records per page

#--------------------------------------------------------------------
# DATE & TIME FORMAT
#--------------------------------------------------------------------
DATE_FORMAT = d/m/Y
TIME_FORMAT = H:i:s
DATETIME_FORMAT = d/m/Y H:i:s

#--------------------------------------------------------------------
# REPORTS
#--------------------------------------------------------------------
REPORT_EXPORT_PATH = ./uploads/reports/
REPORT_LOGO_PATH = ./uploads/company/

#--------------------------------------------------------------------
# API SETTINGS (if applicable)
#--------------------------------------------------------------------
API_ENABLED = false
API_KEY =
API_RATE_LIMIT = 100
# Requests per hour

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
LOG_THRESHOLD = 1
# 0 = Disables logging, Error: 1, Debug: 2, Info: 3, All: 4

LOG_PATH = ./application/logs/
LOG_FILE_EXTENSION = log
LOG_FILE_PERMISSIONS = 0644
LOG_DATE_FORMAT = Y-m-d H:i:s

#--------------------------------------------------------------------
# CACHING
#--------------------------------------------------------------------
CACHE_ENABLED = false
CACHE_DRIVER = file
# Options: file, memcached, redis

CACHE_PATH = ./application/cache/
CACHE_TIME = 3600
# Cache expiration in seconds

#--------------------------------------------------------------------
# INSURANCE SPECIFIC SETTINGS
#--------------------------------------------------------------------
PREMIUM_CALCULATION_MODE = standard
# Options: standard, custom

POLICY_NUMBER_PREFIX = POL
CLAIM_NUMBER_PREFIX = CLM
CUSTOMER_NUMBER_PREFIX = CUST

AUTO_POLICY_RENEWAL = false
# Automatic policy renewal notification

CLAIM_APPROVAL_WORKFLOW = true
# Enable multi-level claim approval

#--------------------------------------------------------------------
# GCC/UAE COMPLIANCE
#--------------------------------------------------------------------
VAT_ENABLED = true
VAT_PERCENTAGE = 5.00
VAT_REGISTRATION_NUMBER =

INSURANCE_AUTHORITY_REPORTING = true
INSURANCE_AUTHORITY_CODE =

AML_KYC_ENABLED = true
# Anti-Money Laundering / Know Your Customer

#--------------------------------------------------------------------
# MULTI-CURRENCY
#--------------------------------------------------------------------
MULTI_CURRENCY_ENABLED = true
BASE_CURRENCY = AED
EXCHANGE_RATE_UPDATE = manual
# Options: manual, auto

#--------------------------------------------------------------------
# NOTIFICATIONS
#--------------------------------------------------------------------
NOTIFICATION_EMAIL = true
NOTIFICATION_SMS = false
NOTIFICATION_SYSTEM = true

SMS_GATEWAY_URL =
SMS_GATEWAY_USERNAME =
SMS_GATEWAY_PASSWORD =

#--------------------------------------------------------------------
# MAINTENANCE MODE
#--------------------------------------------------------------------
MAINTENANCE_MODE = false
MAINTENANCE_MESSAGE = "System under maintenance. Please check back later."

#--------------------------------------------------------------------
# DEBUG & DEVELOPMENT
#--------------------------------------------------------------------
SHOW_PHP_ERRORS = true
# Only for development, set to false in production

PROFILER_ENABLED = false
# CodeIgniter profiler

QUERY_LOG = true
# Log all database queries

#--------------------------------------------------------------------
# THIRD PARTY INTEGRATIONS
#--------------------------------------------------------------------
PAYMENT_GATEWAY_ENABLED = false
PAYMENT_GATEWAY_KEY =
